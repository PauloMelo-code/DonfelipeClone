# ============================================
# Cugini Repasses - Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# Banco de dados
# Dev: file:./dev.db (SQLite)
# Prod: postgresql://user:password@host:5432/cugini
DATABASE_URL="file:./dev.db"

# NextAuth - OBRIGATORIO gerar um secret forte em producao
# Gerar: openssl rand -hex 32
NEXTAUTH_SECRET="gerar-com-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

# UAZAPI - WhatsApp API
UAZAPI_BASE_URL="https://sua-instancia.uazapi.com"
UAZAPI_TOKEN="seu-token-uazapi"

# OpenAI - Extracao de veiculos com GPT-4o
OPENAI_API_KEY="sk-sua-chave-openai"

# Webhook - Seguranca do webhook do UAZAPI
# Gerar: openssl rand -hex 32
# Configurar o mesmo valor no painel UAZAPI
WEBHOOK_SECRET="gerar-com-openssl-rand-hex-32"
