generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
  posts     PostHistory[] @relation("UserPosts")

  @@map("users")
}

model Vehicle {
  id              String    @id @default(cuid())
  model           String
  brand           String?
  year            Int
  yearModel       Int?
  km              Int
  price           Float
  sellingPrice    Float?
  fipePrice       Float?
  transmission    String?
  fuel            String?
  color           String?
  plate           String?
  location        String?
  state           String?
  features        String    @default("[]")
  photos          String    @default("[]")
  /// JSON array paralelo a photos[] com a categoria de cada foto
  /// segundo GPT Vision: exterior|interior|motor|detalhe|screenshot|outro.
  /// Usado pra alertar quando a foto destaque nao e do exterior do carro.
  photoCategories String?
  rawDescription  String?
  sourceGroupId   String?
  sourceMessageId String?   @unique
  sellerPhone     String?
  /// JID de quem postou no grupo fonte (ex: 5511...@s.whatsapp.net).
  /// Usado pra agrupar fotos extras do mesmo anuncio (album).
  sourceSenderJid String?
  vehicleHash     String
  /// Hash de identidade (modelo+ano+km arredondado). Diferente do
  /// vehicleHash, NAO inclui preco. Usado pra dedup de 30 dias com regra
  /// "fica o mais barato" -- mesmo carro reposto com preco menor substitui.
  identityHash    String?
  status          String    @default("PENDING")
  formattedAd     String?
  rejectionReason String?
  rejectionTags   String?
  publishingLockedAt DateTime?
  capturedAt      DateTime  @default(now())
  approvedAt      DateTime?
  publishedAt     DateTime?
  rejectedAt      DateTime?
  /// Marca que o veiculo foi preparado pra publicar depois (texto, fotos
  /// e grupos destino salvos). Quando != null, aparece na aba "Prontos".
  preparedAt      DateTime?
  /// JSON array de groupIds (whatsappgroup.groupId) escolhidos no momento
  /// do "preparar". Usado quando publicar em batch.
  preparedTargetGroupIds String?
  soldAt          DateTime?
  soldPrice       Float?
  soldNotes       String?
  internalNotes   String?
  qualityScore    Int?
  isVip           Boolean   @default(false)
  autoRejectedReason String?
  photoHash       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sourceGroup WhatsAppGroup? @relation("SourceVehicles", fields: [sourceGroupId], references: [groupId])
  postHistory PostHistory[]
  auditLogs   AuditLog[]

  @@index([status])
  @@index([vehicleHash])
  @@index([capturedAt])
  @@index([sourceMessageId])
  @@index([sourceGroupId])
  @@index([state])
  @@index([photoHash])
  @@index([preparedAt])
  @@index([sourceSenderJid])
  @@index([identityHash])
  @@map("vehicles")
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String
  category  String?
  shortcut  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("message_templates")
}

model PostHistory {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicleHash   String
  targetGroupId String
  postedAt      DateTime @default(now())
  messageId     String?
  success       Boolean  @default(true)
  errorMessage  String?
  /// Usuario que disparou a publicacao (null se acao automatica/sistema)
  userId        String?

  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  targetGroup WhatsAppGroup @relation("TargetPosts", fields: [targetGroupId], references: [groupId])
  user        User?         @relation("UserPosts", fields: [userId], references: [id])

  @@index([vehicleHash, targetGroupId, postedAt])
  @@index([postedAt])
  @@index([vehicleId])
  @@map("post_history")
}

model WhatsAppGroup {
  id        String   @id @default(cuid())
  groupId   String   @unique
  name      String
  /// Quando true, o nome foi editado manualmente -- o sync NUNCA sobrescreve.
  nameLocked Boolean @default(false)
  role      String
  active    Boolean  @default(true)
  filters   String?
  photoUrl  String?
  region    String?
  isCommunity Boolean @default(false)
  isAnnounce  Boolean @default(false)
  /// true = DM 1-1 (JID @s.whatsapp.net). Contatos individuais que
  /// podem mandar carros via mensagem direta ou lista de transmissao
  /// (do lado do remetente; do lado de quem recebe chega como DM).
  isContact   Boolean @default(false)
  /// Override manual do tipo. Quando setado, sobrescreve a classificacao
  /// automatica por sufixo do JID. Util quando o usuario quer tratar um
  /// contato (@s.whatsapp.net) como "lista" pra organizar melhor.
  /// Valores: "grupo" | "canal" | "comunidade" | "lista" | "contato"
  kindOverride String?
  ownerPhone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceVehicles Vehicle[]     @relation("SourceVehicles")
  targetPosts    PostHistory[] @relation("TargetPosts")

  @@index([role, active])
  @@map("whatsapp_groups")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  details    String?
  userId     String?
  vehicleId  String?
  /// IP do cliente (X-Forwarded-For / X-Real-IP) -- pra rastreabilidade
  ipAddress  String?
  /// User-Agent do browser/dispositivo
  userAgent  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([vehicleId])
  @@map("audit_logs")
}

model MediaFile {
  id          String   @id @default(uuid())
  mimeType    String   @default("image/jpeg")
  data        String   // base64 encoded
  originalUrl String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("media_files")
}
