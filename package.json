{
  "name": "donfelipe",
  "version": "0.1.0",
  "private": true,
  "description": "Don Felipe Repasses - Plataforma de Monitoramento e Republicacao de Veiculos",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter web exec drizzle-kit generate",
    "db:migrate": "pnpm --filter web exec node scripts/migrate.mjs",
    "db:push": "pnpm --filter web exec drizzle-kit push",
    "db:studio": "pnpm --filter web exec drizzle-kit studio",
    "db:seed": "pnpm --filter web exec tsx scripts/seed.ts",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "tsx": "^4.21.0"
  }
}
